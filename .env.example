# Node.js 24+, on both the storefront build and Worker runtime.
# Must be the final customer-facing HTTPS origin, not the backend origin.
PUBLIC_SITE_URL=https://your-storefront.example

# disabled (default), sandbox (test orders), or live (requires real catalog + stock).
CHECKOUT_MODE=disabled
INVENTORY_READY=false

# Vercel only: the deployed Sites/Cloudflare backend HTTPS origin.
SITES_BACKEND_URL=https://your-backend.example
# For local Next.js development against a separately deployed backend:
# STORE_RUNTIME=proxy

# Worker only: encrypted server-side merchant secrets, never NEXT_PUBLIC_*.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
